FROM python:3.9-slim-bullseye

# System-Abhängigkeiten installieren
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    swig \
    gfortran \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    libopenblas-dev \
    libatlas-base-dev \
    && rm -rf /var/lib/apt/lists/*

# Pip upgraden
RUN pip install --no-cache-dir --upgrade pip
RUN pip install --no-cache-dir numpy==1.21.6
RUN pip install --no-cache-dir scipy==1.7.3
RUN pip install --no-cache-dir scikit-learn==0.24.2
RUN pip install --no-cache-dir pandas==1.3.5
RUN pip install --no-cache-dir joblib==1.1.1
RUN pip install --no-cache-dir threadpoolctl==3.1.0
RUN pip install --no-cache-dir matplotlib==3.5.3
RUN pip install --no-cache-dir seaborn==0.11.2

# Jupyter installieren
RUN pip install --no-cache-dir jupyter

# auto-sklearn 0.15.0 installieren
RUN pip install --no-cache-dir auto-sklearn==0.15.0

WORKDIR /app

ENV OMP_NUM_THREADS=1
ENV MKL_NUM_THREADS=1
ENV OPENBLAS_NUM_THREADS=1

EXPOSE 8888

CMD ["jupyter", "notebook", "--ip=0.0.0.0", "--port=8888", "--no-browser", "--allow-root"]