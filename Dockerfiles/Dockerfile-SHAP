FROM python:3.9-slim-bullseye

# System-Abhängigkeiten installieren
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    swig \
    gfortran \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    libopenblas-dev \
    libatlas-base-dev \
    && rm -rf /var/lib/apt/lists/*


RUN pip install --no-cache-dir --upgrade pip
RUN pip install --no-cache-dir numpy==1.21.6
RUN pip install --no-cache-dir scipy==1.7.3
RUN pip install --no-cache-dir scikit-learn==0.24.2
RUN pip install --no-cache-dir pandas==1.3.5
RUN pip install --no-cache-dir joblib==1.1.1
RUN pip install --no-cache-dir threadpoolctl==3.1.0
RUN pip install --no-cache-dir matplotlib==3.5.3
RUN pip install --no-cache-dir seaborn==0.11.2

# Jupyter installieren
RUN pip install --no-cache-dir jupyter

# auto-sklearn is only here for testing reasons
RUN pip install --no-cache-dir auto-sklearn==0.15.0

# SEPARATES VENV FUER SHAP (XAI), da ansonsten Paketprobleme entstehen

RUN python3 -m venv /opt/shap-venv \
    && /opt/shap-venv/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/shap-venv/bin/pip install --no-cache-dir \
        numpy pandas scipy scikit-learn matplotlib shap ipykernel

# Als eigenen Jupyter-Kernel registrieren
RUN /opt/shap-venv/bin/python -m ipykernel install --name shap-venv --display-name "Python (shap-venv)"

WORKDIR /app

ENV OMP_NUM_THREADS=1
ENV MKL_NUM_THREADS=1
ENV OPENBLAS_NUM_THREADS=1

EXPOSE 8888

CMD ["jupyter", "notebook", "--ip=0.0.0.0", "--port=8888", "--no-browser", "--allow-root"]